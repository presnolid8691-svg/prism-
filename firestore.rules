rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isUser(uid) { return isAuth() && request.auth.uid == uid; }
    
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      
      match /{document=**} {
        allow read, write: if isUser(userId);
      }
    }
    
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuth() && resource.data.senderId == request.auth.uid;
      }
    }

    match /channels/{channelId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      match /{document=**} { allow read, write: if isAuth(); }
    }

    match /feed/{postId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      match /{document=**} { allow read, write: if isAuth(); }
    }
    
    match /stories/{storyId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      match /{document=**} { allow read, write: if isAuth(); }
    }

    match /qaLinks/{token} {
      allow read: if true;
      allow create, update: if isAuth();
      match /submissions/{submissionId} {
        allow read: if isAuth();
        allow create: if true; // Anonymous write
      }
    }

    match /webrtcSessions/{sessionId} {
      allow read, write: if isAuth();
      match /{document=**} { allow read, write: if isAuth(); }
    }
  }
}